<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/processSquareRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp"
    android:background="@drawable/process_square_bg"
    android:minWidth="90dp"
    android:minHeight="56dp">

    <TextView
        android:id="@+id/processName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/game_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/processColorBar"
        android:layout_width="50dp"
        android:layout_height="5dp"
        android:layout_marginVertical="2dp" />

    <TextView
        android:id="@+id/processArrival"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/processBurst"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/processPriority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
