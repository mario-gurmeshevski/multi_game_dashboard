<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/logic_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/logic_bar_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="@string/content_desc_back"/>

        <TextView
            android:id="@+id/levelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/logic_text_primary"
            android:text="@string/level_1"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timer_initial"
                android:textSize="24sp"
                android:textColor="@color/logic_text_primary"
                android:fontFamily="monospace"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/taskInfoButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:textSize="14sp"
                    android:textColor="@color/logic_btn_primary_text"
                    android:backgroundTint="@color/logic_btn_primary"
                    android:visibility="gone"
                    android:padding="0dp"
                    android:text=""/>

                <TextView
                    android:id="@+id/star1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/star"
                    android:textSize="28sp"
                    android:textColor="@color/logic_star_active"/>

                <TextView
                    android:id="@+id/star2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/star"
                    android:textSize="28sp"
                    android:textColor="@color/logic_star_active"
                    android:layout_marginHorizontal="4dp"/>

                <TextView
                    android:id="@+id/star3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/star"
                    android:textSize="28sp"
                    android:textColor="@color/logic_star_active"/>

            </LinearLayout>


            <TextView
                android:id="@+id/instructionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/logic_text_secondary"/>

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/gameCanvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/logic_canvas_bg"/>

    <HorizontalScrollView
        android:id="@+id/componentToolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/logic_toolbar_bg"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drag"
                android:textSize="11sp"
                android:textColor="@color/logic_text_muted"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:id="@+id/chipButton"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/level_bg"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn"
                    android:textSize="12sp"
                    android:textColor="@color/logic_chip_label"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button"
                    android:textSize="11sp"
                    android:textColor="@color/logic_chip_subtext"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipAnd"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/level_bg"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/and"
                    android:textSize="12sp"
                    android:textColor="@color/logic_gate_text"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gate"
                    android:textSize="11sp"
                    android:textColor="@color/logic_chip_subtext"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipOr"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/level_bg"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/or"
                    android:textSize="12sp"
                    android:textColor="@color/logic_gate_text"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gate"
                    android:textSize="11sp"
                    android:textColor="@color/logic_chip_subtext"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipNot"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/level_bg"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not"
                    android:textSize="12sp"
                    android:textColor="@color/logic_gate_text"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gate"
                    android:textSize="11sp"
                    android:textColor="@color/logic_chip_subtext"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/logic_bottom_bar_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/hintButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/hint"
            android:textSize="11sp"
            android:backgroundTint="@color/logic_btn_hint_bg"
            android:textColor="@color/logic_btn_hint_text"/>
        <Button
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/trash"
            android:textSize="16sp"
            android:backgroundTint="@color/logic_btn_delete_bg"
            android:textColor="@color/logic_btn_delete_text"
            android:visibility="gone"
            android:layout_marginStart="8dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/checkButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/check_circuit"
            android:textSize="11sp"
            android:backgroundTint="@color/logic_btn_primary"
            android:textColor="@color/logic_btn_primary_text"
            android:enabled="false"/>

    </LinearLayout>

</LinearLayout>
