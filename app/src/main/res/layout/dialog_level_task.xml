<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:id="@+id/taskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/target_task"
            android:textSize="20sp"
            android:textColor="@color/task_label_text"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/taskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/logic_text_primary"
            android:layout_marginBottom="16dp"
            android:gravity="center"/>

        <LinearLayout
            android:id="@+id/rulesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/logic_toolbar_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ten"
            android:textSize="36sp"
            android:textColor="@color/logic_star_active"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/timerHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timer_starts_when_popup_closes"
            android:textSize="11sp"
            android:textColor="@color/task_hint_text"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnGotIt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/got_it_start_timer"
            android:textSize="14sp"
            android:textColor="@color/dialog_btn_next_text"
            android:backgroundTint="@color/dialog_btn_next_bg"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>
