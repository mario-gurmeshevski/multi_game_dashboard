<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/titleText"
        style="@style/TextStyle.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:layout_gravity="start"
        android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center"
            android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/schedulerButton"
            android:layout_width="240dp"
            android:layout_height="200dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_background_ripple"
            android:clickable="true"
            android:focusable="true"
            android:padding="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_scheduler"
                android:contentDescription="@string/content_desc_scheduler"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/TextStyle.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_scheduler"
                android:layout_marginBottom="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/logicButton"
            android:layout_width="240dp"
            android:layout_height="200dp"
            android:layout_marginStart="24dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_background_ripple"
            android:clickable="true"
            android:focusable="true"
            android:padding="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_logic_circuit"
                android:contentDescription="@string/content_desc_logic"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/TextStyle.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_logic"
                android:layout_marginBottom="4dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
