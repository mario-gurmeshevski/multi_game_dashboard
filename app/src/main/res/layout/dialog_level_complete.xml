<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/panel_bg">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Level Complete!"
        android:textSize="22sp"
        android:textColor="#E0E0E0"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Ѕвезди -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/dialogStar1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textSize="40sp"
            android:textColor="#FFD700"/>

        <TextView
            android:id="@+id/dialogStar2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textSize="48sp"
            android:textColor="#FFD700"
            android:layout_marginHorizontal="8dp"/>

        <TextView
            android:id="@+id/dialogStar3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textSize="40sp"
            android:textColor="#FFD700"/>

    </LinearLayout>

    <!-- Копчиња -->
    <Button
        android:id="@+id/btnNextLevel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Next Level"
        android:textColor="#FFFFFF"
        android:backgroundTint="#533ab7"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnRetry"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Try Again"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2a2255"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Back to Menu"
        android:textColor="#AAAAAA"
        android:backgroundTint="#1a1a3a"/>

</LinearLayout>