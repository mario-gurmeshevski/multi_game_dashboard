<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/panel_bg">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/level_complete"
        android:textSize="22sp"
        android:textColor="@color/dialog_title_text"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/dialogStar1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/star"
            android:textSize="40sp"
            android:textColor="@color/logic_star_active"/>

        <TextView
            android:id="@+id/dialogStar2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/star"
            android:textSize="48sp"
            android:textColor="@color/logic_star_active"
            android:layout_marginHorizontal="8dp"/>

        <TextView
            android:id="@+id/dialogStar3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/star"
            android:textSize="40sp"
            android:textColor="@color/logic_star_active"/>

    </LinearLayout>

    <TextView
        android:id="@+id/dialogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/dialog_title_text"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnNextLevel"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/next_level"
        android:textColor="@color/dialog_btn_next_text"
        android:textAllCaps="false"
        android:paddingHorizontal="16dp"
        android:backgroundTint="@color/dialog_btn_next_bg"
        android:layout_marginBottom="8dp"/>


    <Button
        android:id="@+id/btnRetry"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/try_again"
        android:textColor="@color/dialog_btn_next_text"
        android:textAllCaps="false"
        android:paddingHorizontal="16dp"
        android:backgroundTint="@color/dialog_btn_next_bg"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/back_to_menu"
        android:textColor="@color/dialog_btn_next_text"
        android:textAllCaps="false"
        android:paddingHorizontal="16dp"
        android:backgroundTint="@color/dialog_btn_next_bg"/>

</LinearLayout>
