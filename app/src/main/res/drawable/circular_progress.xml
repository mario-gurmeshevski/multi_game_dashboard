<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape
            android:shape="ring"
            android:thickness="12dp"
            android:useLevel="false">

            <solid android:color="@color/game_progress_track"/>
        </shape>
    </item>

    <item>
        <rotate
            android:fromDegrees="0"
            android:toDegrees="360">

            <shape
                android:shape="ring"
                android:thickness="12dp"
                android:useLevel="true">

                <solid android:color="@color/game_progress_fill"/>
            </shape>

        </rotate>
    </item>

</layer-list>
